# GENERATED by asp from src/asp/device.py - product identity variables.
PRODUCT_BRAND := {{ d.brand }}
PRODUCT_MANUFACTURER := {{ d.manufacturer }}
PRODUCT_MODEL := {{ d.model }}
{% if d.marketing_name %}
PRODUCT_PROPERTY_OVERRIDES += ro.product.marketname={{ d.marketing_name }}
{% endif %}
{% if d.device %}
PRODUCT_DEVICE := {{ d.device }}
{% endif %}
{% if d.board %}
TARGET_BOOTLOADER_BOARD_NAME := {{ d.board }}
{% endif %}
{% if d.fingerprint %}
PRODUCT_BUILD_PROP_OVERRIDES += BUILD_FINGERPRINT={{ d.fingerprint }}
{% endif %}
{% if d.description %}
PRODUCT_BUILD_PROP_OVERRIDES += PRIVATE_BUILD_DESC="{{ d.description }}"
{% endif %}
{% if d.display_id %}
PRODUCT_BUILD_PROP_OVERRIDES += BUILD_DISPLAY_ID={{ d.display_id }}
{% endif %}
PRODUCT_LOCALES := {{ d.locale }}
PRODUCT_DEFAULT_PROPERTY_OVERRIDES += persist.sys.timezone={{ d.timezone }}
{% for key, value in d.properties %}
PRODUCT_PROPERTY_OVERRIDES += {{ key }}={{ value }}
{% endfor %}
