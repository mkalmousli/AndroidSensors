cc_binary {
    name: "andros_health",
    stem: "android.hardware.health-service.andros",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["*.cpp"],
    static_libs: [
        "libandros_store",
        "libhealthloop",
        "libhealth_aidl_impl",
        "libhealthshim",
    ],
    shared_libs: [
        "android.hardware.health-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    init_rc: ["health.rc"],
    vintf_fragments: ["health.xml"],
    cflags: ["-Wall", "-Werror"],
}
